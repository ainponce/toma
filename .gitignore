# Generated by XcodeGen (make project), except the app's package pins: without this file Xcode would
# write them into Packages/RecorderKit/Package.resolved.
Toma.xcodeproj/*
!Toma.xcodeproj/project.xcworkspace/
Toma.xcodeproj/project.xcworkspace/*
!Toma.xcodeproj/project.xcworkspace/xcshareddata/
Toma.xcodeproj/project.xcworkspace/xcshareddata/*
!Toma.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Toma.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Toma.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
dist/

