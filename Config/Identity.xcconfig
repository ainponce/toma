// SPDX-License-Identifier: GPL-3.0-or-later
// Single source of truth for the app identity. Frozen before the first build that reaches another Mac.
// In .xcconfig, "//" starts a comment: write URLs and base64 keys with "/$()/".
PRODUCT_NAME = Toma
PRODUCT_BUNDLE_IDENTIFIER = dev.toma.Toma
MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
// The project document type. PROJECT_FILE_EXTENSION must equal ProjectPackage.fileExtension.
PROJECT_TYPE_IDENTIFIER = dev.toma.project
PROJECT_FILE_EXTENSION = toma
// The named style document type (1c design §8): a package that can be sent to another Mac, imported when opened.
// STYLE_FILE_EXTENSION must equal StyleMenu.fileExtension, the extension StyleLibrary names its packages with.
STYLE_TYPE_IDENTIFIER = dev.toma.style
STYLE_FILE_EXTENSION = tomastyle
// Sparkle: the update feed, and the EdDSA public key that generate_keys prints (docs/release.md). Without
// the key the app starts without its updater.
SPARKLE_FEED_URL = http:/$()/localhost:8000/appcast.xml
SPARKLE_PUBLIC_KEY =
// The repository the source code of a release is published at (GPLv3 §6), for example
// https:/$()/github.com/<owner>/<repo>. The release workflow sets it from the repository it runs in; a
// build without it says so in Acknowledgements.
SOURCE_CODE_URL =
