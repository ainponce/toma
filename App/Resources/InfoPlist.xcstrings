{
  "sourceLanguage" : "en",
  "strings" : {
    "$(PRODUCT_NAME) Project" : {
      "comment" : "Kind of a project document in Finder. The name of the app is put in when building.",
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyecto de $(PRODUCT_NAME)"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Shown by macOS when the app first asks for the camera. The name of the app is put in when building.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$(PRODUCT_NAME) muestra y graba la cámara solo cuando se activa para una grabación."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "The copyright line in Finder's Get Info and the About panel. The name of the app is put in when building.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2026 los colaboradores de $(PRODUCT_NAME). Software libre bajo la GNU GPL, versión 3 o posterior, sin ninguna garantía."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Shown by macOS when the app first asks for the microphone. The name of the app is put in when building.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "$(PRODUCT_NAME) graba el micrófono solo cuando se activa para una grabación."
          }
        }
      }
    }
  },
  "version" : "1.0"
