    "The whole display is recorded: what's outside the area is saved too. The area can be changed later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se graba la pantalla completa: lo que queda fuera del área también se guarda. El área se puede cambiar después."
          }
        }
      }
    },
    "The window can't be found. It may have been closed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra la ventana. Puede que se haya cerrado."
          }
        }
      }
    },
    "The window stopped recording." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana dejó de grabarse."
          }
        }
      }
    },
    "The window you're recording is minimized or hidden. Recording continues when it's back." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana que se graba está minimizada u oculta. La grabación sigue cuando vuelva."
          }
        }
      }
    },
    "There has to be at least one clip." : {
      "comment" : "The timeline: what is said when the last clip is deleted",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene que quedar al menos un tramo."
          }
        }
      }
    },
    "There isn't enough free disk space to record (%@ available)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay suficiente espacio libre en el disco para grabar (%@ disponibles)."
          }
        }
      }
    },
    "There's no room to duplicate it: %@ are needed." : {
      "comment" : "The library: a duplicate on a full disk",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay lugar para duplicarlo: hacen falta %@."
          }
        }
      }
    },
    "These projects can't be read safely and were left untouched:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos proyectos no se pueden leer de forma segura y no se modificaron:"
          }
        }
      }
    },
    "They were left as they are. To try again, use Recover Recordings… in the menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedaron como estaban. Para volver a intentarlo, usar Recuperar grabaciones… en la barra de menú."
          }
        }
      }
    },
    "Third-Party Licenses" : {
      "comment" : "The title of the window with the licenses of the software the app includes",
