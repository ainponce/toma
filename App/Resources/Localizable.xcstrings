    "A recording is already in progress." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una grabación en curso."
          }
        }
      }
    },
    "A shortcut you make in Shortcuts turns it on while recording, so notifications don't sound. They never appear in the video." : {
      "comment" : "Under Do Not Disturb in the permissions window",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un atajo creado en Atajos lo activa al grabar, así no suenan las notificaciones. Nunca salen en el video."
          }
        }
      }
    },
