          }
        }
      }
    },
    "The video was exported, but %lld parts have no sound: their microphone audio couldn't be read." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The video was exported, but %lld part has no sound: its microphone audio couldn't be read."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The video was exported, but %lld parts have no sound: their microphone audio couldn't be read."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El video se exportó, pero %lld parte quedó sin sonido: no se pudo leer su audio del micrófono."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El video se exportó, pero %lld partes quedaron sin sonido: no se pudo leer su audio del micrófono."
                }
              }
            }
          }
