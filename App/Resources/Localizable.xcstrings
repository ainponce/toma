{
  "sourceLanguage" : "en",
  "strings" : {
    "%1$@ — %2$@" : {
      "comment" : "An app and its window's title: a desktop of an app in full screen, or a window to record",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — %2$@"
          }
        }
      }
    },
    "%1$@, from %2$@ to %3$@" : {
      "comment" : "VoiceOver: a privacy block of the timeline, its effect, start and end",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, de %2$@ a %3$@"
          }
        }
      }
    },
    "%@ (and %lld more)" : {
      "comment" : "The library's strip: the first failure, and how many more",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (y %2$lld más)"
