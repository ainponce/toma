    "Timeline Scale" : {
      "comment" : "The timeline's track bar: the scale's slider",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escala de la línea de tiempo"
          }
        }
