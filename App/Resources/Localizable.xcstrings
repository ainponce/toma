        }
      }
    },
    "These projects can't be read safely and were left untouched:" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos proyectos no se pueden leer de forma segura y no se modificaron:"
          }
        }
      }
    },
    "They were left as they are. To try again, use Recover Recordings… in the menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedaron como estaban. Para volver a intentarlo, usar Recuperar grabaciones… en la barra de menú."
          }
        }
      }
    },
    "Third-Party Licenses" : {
      "comment" : "The title of the window with the licenses of the software the app includes",
      "localizations" : {
        "es" : {
