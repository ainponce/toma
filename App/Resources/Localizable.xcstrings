      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios de la toma solo se ven fuera de los bloques, con la disposición Burbuja; los de adentro siguen contando después."
          }
        }
      }
    },
    "The recording's format can't be saved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede guardar el formato de la grabación."
          }
        }
