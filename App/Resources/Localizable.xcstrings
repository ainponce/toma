    "The microphone couldn't be set up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo configurar el micrófono."
          }
        }
      }
    },
    "The microphone couldn't start. Recording the screen without audio." : {
      "localizations" : {
