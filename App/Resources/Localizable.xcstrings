{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (details: %@)" : {
      "comment" : "A damaged project: its name, and recovery's technical reason",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (detalle: %@)"
          }
        }
      }
    },
    "A file isn't inside the project." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo no está dentro del proyecto."
          }
        }
      }
    },
    "A recording file with the same name already exists. It was left untouched." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un archivo de grabación con el mismo nombre. No se modificó."
