    "A GIF longer than a minute is heavy. Mark a range (I and O) or export MP4." : {
      "comment" : "The export sheet: a GIF of more than 60 s",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un GIF de más de un minuto pesa mucho. Conviene marcar un rango (I y O) o exportar en MP4."
          }
        }
      }
    },
    "A GIF this heavy is better exported as MP4." : {
      "comment" : "The export sheet: a GIF estimated at more than 50 MB",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un GIF así pesa mucho: conviene exportar en MP4."
          }
        }
      }
    },
    "A file isn't inside the project." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo no está dentro del proyecto."
          }
        }
      }
    },
    "A project with that name already exists." : {
      "comment" : "The library: beside a name being edited",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay un proyecto con ese nombre."
